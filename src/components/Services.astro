---
const services = [
  'General Crane Hire',
  'Steel Erection',
  'Shutdown Works',
  'Engineered Lift Studies',
  'Riggers/Dogmen',
  'Heavy Haulage',
  'Site Sheds & Safes',
  'Electrical Spotters/Traffic Controllers',
  'Traffic Management Plans'
];
---

<section class="container-fluid p-0 min-vh-100 parallax" id="services">
  <div class="container-fluid p-0 min-vh-100 d-flex justify-content-center align-items-center">
    <div class="row px-4 g-0 justify-content-center align-items-center">
      <div class="text-white p-0 animate-bottom">
        <h2>Services</h2>
        <ul>
          {services.map((service) => <li>{service}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
