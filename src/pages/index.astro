---
import About from '../components/About.astro';
import Civil from '../components/Civil.astro';
import Contact from '../components/Contact.astro';
import Domestic from '../components/Domestic.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Industrial from '../components/Industrial.astro';
import Safety from '../components/Safety.astro';
import Services from '../components/Services.astro';
import Social from '../components/Social.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'Old Mate Cranes & Rigging offer safe and simple solutions for all your lifting needs.';
---

<BaseLayout description={description} title="old mate cranes & rigging">
  <main class="container-fluid px-0">
    <Header />
    <Hero />
    <About />
    <Services />
    <Safety />
    <Social />
    <Domestic />
    <Industrial />
    <Civil />
    <Contact />
    <Footer />
  </main>
</BaseLayout>
